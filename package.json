{
  "name": "hrms-college-project",
  "version": "1.0.0",
  "description": "Secure Firebase-hosted Human Resource Management System",
  "private": true,
  "scripts": {
    "start": "firebase emulators:start --project demo-no-project --only hosting",
    "dev": "firebase emulators:start --project demo-no-project --only hosting,auth,firestore",
    "serve": "firebase emulators:start --project demo-no-project --only hosting",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-no-project --only firestore \"node --test tests/firestore-rules.test.js\"",
    "check": "npm run test:unit",
    "build": "esbuild public/js/firebase-bootstrap.js --bundle --format=esm --minify --outfile=public/js/firebase-bundle.js",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --only hosting",
    "seed": "node scripts/seed-firestore.js",
    "provision:user": "node scripts/provision-user.js",
    "change:user-email": "node scripts/change-user-email.js"
  },
  "keywords": [
    "hrms",
    "hr-management",
    "college-project",
    "btech-cse",
    "firebase",
    "firestore"
  ],
  "author": "B.Tech CSE Student",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.1",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.25.11",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.23.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
